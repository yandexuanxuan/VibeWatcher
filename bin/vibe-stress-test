#!/bin/bash
#
# VibeWatcher Stress Test
# 压力测试脚本 - 模拟多个并发任务和消息
#

set -e

HOST="${VIBEWATCH_HOST:-localhost}"
PORT="${VIBEWATCH_PORT:-9234}"
TASKS="${1:-10}"
DURATION="${2:-30}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "=============================================="
echo "      VibeWatcher Stress Test"
echo "=============================================="
echo ""
echo "配置: $TASKS 并发任务, $DURATION 秒测试"
echo ""

# 检查 server 是否运行
if ! nc -z $HOST $PORT 2>/dev/null; then
    echo -e "${RED}错误: ${NC}无法连接到 $HOST:$PORT"
    echo "请先运行: vibe-daemon start"
    exit 1
fi

# 创建临时 WebSocket 测试脚本
cat > /tmp/ws-test.js << 'EOF'
const WebSocket = require('ws');

const HOST = process.argv[2] || 'localhost';
const PORT = process.argv[3] || '9234';
const TASK_ID = process.argv[4];
const OUTPUT_COUNT = parseInt(process.argv[5]) || 100;

const ws = new WebSocket(`ws://${HOST}:${PORT}`);

ws.on('open', () => {
    // 发送任务创建
    ws.send(JSON.stringify({
        type: 'TASK_CREATED',
        payload: { taskId: TASK_ID, keyword: 'stress-test' }
    }));

    // 发送初始状态
    ws.send(JSON.stringify({
        type: 'TASK_STATUS',
        payload: { taskId: TASK_ID, status: 'RUNNING' }
    }));

    // 发送大量输出
    let count = 0;
    const interval = setInterval(() => {
        ws.send(JSON.stringify({
            type: 'TASK_OUTPUT',
            payload: {
                taskId: TASK_ID,
                type: 'stdout',
                data: `Test output line ${++count}\n`
            }
        }));

        if (count >= OUTPUT_COUNT) {
            clearInterval(interval);
            ws.send(JSON.stringify({
                type: 'TASK_STATUS',
                payload: { taskId: TASK_ID, status: 'COMPLETED' }
            }));
            ws.send(JSON.stringify({
                type: 'TASK_EXIT',
                payload: { taskId: TASK_ID, exitCode: 0, duration: 1000 }
            }));
            ws.close();
            process.exit(0);
        }
    }, 10);
});

ws.on('error', (err) => {
    console.error('WS Error:', err.message);
    process.exit(1);
});
EOF

# 运行并发测试
echo "启动 $TASKS 个并发任务..."
START_TIME=$(date +%s)

FAILED=0
SUCCESS=0

for i in $(seq 1 $TASKS); do
    TASK_ID="stress-test-$(date +%s)-$i"

    # 后台启动测试进程
    node /tmp/ws-test.js $HOST $PORT $TASK_ID 50 &

    if [ $((i % 10)) -eq 0 ]; then
        echo "  已启动 $i/$TASKS 个任务..."
    fi
done

echo "  已启动 $TASKS 个任务, 运行 ${DURATION}s..."

# 等待测试完成
sleep $DURATION

# 清理后台进程
pkill -f "ws-test.js" 2>/dev/null || true

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo ""
echo "=============================================="
echo "测试完成!"
echo "=============================================="
echo "耗时: ${ELAPSED}s"
echo "任务数: $TASKS"
echo ""

# 清理
rm -f /tmp/ws-test.js
