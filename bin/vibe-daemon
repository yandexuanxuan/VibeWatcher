#!/bin/bash
#
# VibeWatcher Daemon Manager
# Manages the WebSocket server process in the background
#

set -e

INSTALL_DIR="${VIBEWATCH_HOME:-$HOME/.vibewatch}"
SERVER_DIR="$INSTALL_DIR/bin"
SERVER_BIN="$SERVER_DIR/server.js"
PID_FILE="$INSTALL_DIR/run/vibewatcher.pid"
LOG_FILE="$INSTALL_DIR/logs/server.log"
PID_DIR="$(dirname "$PID_FILE")"
LOG_DIR="$(dirname "$LOG_FILE")"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Read PID from file (with null safety)
read_pid() {
    if [ -f "$PID_FILE" ] && [ -s "$PID_FILE" ]; then
        cat "$PID_FILE"
    fi
}

# Check if process is running
is_running() {
    local pid=$(read_pid)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Check if server binary exists
check_server_binary() {
    if [ ! -f "$SERVER_BIN" ]; then
        log_error "Server binary not found at $SERVER_BIN"
        log_error "Run 'install.sh' first to install VibeWatcher"
        return 1
    fi
    return 0
}

cmd_start() {
    mkdir -p "$PID_DIR" "$LOG_DIR"

    # Auto-clean old summaries on start
    cmd_cleanup 3 2>/dev/null || true

    if is_running; then
        local pid=$(read_pid)
        log_info "Server already running (PID: $pid)"
        return 0
    fi

    check_server_binary || return 1

    log_info "Starting VibeWatcher server..."

    # Start in background from the server directory (has node_modules)
    cd "$SERVER_DIR"
    nohup node server.js > "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    # Wait briefly and verify
    sleep 1

    if kill -0 "$pid" 2>/dev/null; then
        log_info "Server started successfully (PID: $pid)"
        log_info "Logs: $LOG_FILE"
        return 0
    else
        log_error "Failed to start server. Check logs: $LOG_FILE"
        rm -f "$PID_FILE"
        return 1
    fi
}

cmd_stop() {
    local pid=$(read_pid)

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        log_info "Stopping server (PID: $pid)..."
        kill "$pid" 2>/dev/null || true
        rm -f "$PID_FILE"

        # Wait for process to stop
        local count=0
        while kill -0 "$pid" 2>/dev/null && [ $count -lt 10 ]; do
            sleep 0.5
            count=$((count + 1))
        done

        if kill -0 "$pid" 2>/dev/null; then
            log_warn "Force killing server..."
            kill -9 "$pid" 2>/dev/null || true
        fi

        log_info "Server stopped"
    else
        rm -f "$PID_FILE"
        log_info "Server not running"
    fi
}

cmd_restart() {
    log_info "Restarting server..."
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    local pid=$(read_pid)

    if is_running; then
        echo -e "${GREEN}Server running${NC} (PID: $pid)"
        return 0
    else
        echo -e "${YELLOW}Server not running${NC}"
        [ -f "$PID_FILE" ] && rm -f "$PID_FILE"
        return 1
    fi
}

cmd_log() {
    if [ -f "$LOG_FILE" ]; then
        tail -n 50 "$LOG_FILE"
    else
        log_error "Log file not found: $LOG_FILE"
        return 1
    fi
}

cmd_tail() {
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        log_error "Log file not found: $LOG_FILE"
        return 1
    fi
}

cmd_cleanup() {
    local days="${1:-7}"
    local summaries_dir="$INSTALL_DIR/summaries"

    if [ ! -d "$summaries_dir" ]; then
        log_info "No summaries directory found"
        return 0
    fi

    local count=$(find "$summaries_dir" -name "*.md" -mtime +"$days" | wc -l)

    if [ "$count" -eq 0 ]; then
        log_info "No summaries older than ${days} days to clean"
        return 0
    fi

    find "$summaries_dir" -name "*.md" -mtime +"$days" -delete
    log_info "Cleaned $count summaries older than ${days} days"
}

# Show usage
usage() {
    cat << EOF
VibeWatcher Daemon Manager

Usage: vibe-daemon <command>

Commands:
    start              Start the server in background
    stop               Stop the running server
    restart            Restart the server
    status             Show server status
    log                Show recent server logs
    tail               Follow server logs (Ctrl+C to exit)
    cleanup [days]     Delete summaries older than N days (default: 7)
    --if-not-running   Start only if not already running

Examples:
    vibe-daemon start
    vibe-daemon status
    vibe-daemon stop
    vibe-daemon log

EOF
}

# Main command router
case "${1:-}" in
    start|--if-not-running)
        if [ "$1" = "--if-not-running" ]; then
            is_running && log_info "Server already running" && exit 0
        fi
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    log)
        cmd_log
        ;;
    tail)
        cmd_tail
        ;;
    cleanup)
        cmd_cleanup "$2"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        if [ -n "$1" ]; then
            log_error "Unknown command: $1"
        fi
        usage
        exit 1
        ;;
esac
