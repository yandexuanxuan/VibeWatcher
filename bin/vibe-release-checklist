#!/bin/bash
#
# VibeWatcher Release Checklist
# 发布前检查清单
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

CHECKED=0
TOTAL=0

check() {
    local desc="$1"
    local result="$2"

    TOTAL=$((TOTAL + 1))

    if [ "$result" = "pass" ]; then
        echo -e "  ${GREEN}✓${NC} $desc"
        CHECKED=$((CHECKED + 1))
    elif [ "$result" = "skip" ]; then
        echo -e "  ${YELLOW}⊘${NC} $desc (跳过)"
    else
        echo -e "  ${RED}✗${NC} $desc"
    fi
}

echo "=============================================="
echo "     VibeWatcher v1.0 Release Checklist"
echo "=============================================="
echo ""

echo "【1. 代码质量】"
cd /home/dev/projects/VibeWatcher

# TypeScript 编译
if npm run build 2>&1 | grep -q "error"; then
    check "TypeScript 编译" "fail"
else
    check "TypeScript 编译" "pass"
fi

# VSCode 扩展
if [ -f "vibewatcher-vscode/out/extension.js" ]; then
    check "VSCode 扩展编译" "pass"
else
    check "VSCode 扩展编译" "fail"
fi

# 图标文件
if [ -f "vibewatcher-vscode/media/icon.svg" ]; then
    check "图标文件存在" "pass"
else
    check "图标文件存在" "fail"
fi

echo ""
echo "【2. 版本一致性】"
VERSION="1.0.0"

# 检查各包版本
for pkg in vibewatcher-cli vibewatcher-server vibewatcher-vscode; do
    PKG_VERSION=$(grep -oP "\"version\":\s*\"\K[^\"]+" "$pkg/package.json" 2>/dev/null || echo "")
    if [ "$PKG_VERSION" = "$VERSION" ]; then
        check "$pkg 版本 $VERSION" "pass"
    else
        check "$pkg 版本 $VERSION" "fail"
    fi
done

echo ""
echo "【3. 文件完整性】"

# 检查关键文件
FILES=(
    "README.md"
    "CLAUDE.md"
    "LICENSE"
    "install.sh"
    "bin/vibe-daemon"
    "bin/vibe"
    "bin/vibe-doctor"
    "bin/vibe-stress-test"
    "vibewatcher-server/src/daemon-server.ts"
    "vibewatcher-cli/src/daemon-client.ts"
    "vibewatcher-vscode/src/extension.ts"
)

for file in "${FILES[@]}"; do
    if [ -f "$file" ]; then
        check "文件: $file" "pass"
    else
        check "文件: $file" "fail"
    fi
done

echo ""
echo "【4. VSCode 扩展元数据】"
cd /home/dev/projects/VibeWatcher/vibewatcher-vscode

if grep -q "displayName" package.json; then
    check "displayName" "pass"
else
    check "displayName" "fail"
fi

if grep -q "repository" package.json; then
    check "repository" "pass"
else
    check "repository" "fail"
fi

if [ -f "README.md" ]; then
    check "VSCode README.md" "pass"
else
    check "VSCode README.md" "fail"
fi

if [ -f "LICENSE" ] || [ -f "../LICENSE" ]; then
    check "LICENSE 文件" "pass"
else
    check "LICENSE 文件" "fail"
fi

echo ""
echo "【5. 文档检查】"
cd /home/dev/projects/VibeWatcher

if grep -q "v1.0" README.md; then
    check "README.md 版本号" "pass"
else
    check "README.md 版本号" "fail"
fi

if grep -q "v1.0" CLAUDE.md; then
    check "CLAUDE.md 版本状态" "pass"
else
    check "CLAUDE.md 版本状态" "fail"
fi

echo ""
echo "=============================================="
echo "检查完成: $CHECKED/$TOTAL 项通过"
echo "=============================================="
echo ""

if [ $CHECKED -eq $TOTAL ]; then
    echo -e "${GREEN}准备发布!${NC}"
    echo ""
    echo "下一步:"
    echo -e "  1. ${CYAN}cd vibewatcher-vscode && vsce package${NC}"
    echo -e "  2. ${CYAN}git add . && git commit -m \"release: v$VERSION\"${NC}"
    echo -e "  3. ${CYAN}git tag v$VERSION && git push --tags${NC}"
    echo -e "  4. ${CYAN}vsce publish${NC} (发布到 Marketplace)"
    exit 0
else
    echo -e "${RED}请修复上述失败项后再发布${NC}"
    exit 1
fi
